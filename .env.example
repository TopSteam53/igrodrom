# Скопируйте в .env и заполните. После изменений: docker compose up -d
# Домен, уже направленный A-записью на IP сервера.
DOMAIN=igrodrom.ru
# Владельцы площадки через запятую (могут всё, назначают модераторов). Зарегистрируйтесь на сайте с этим адресом.
ADMIN_EMAILS=you@example.com

# ---------- Почта: подтверждение адреса и сброс пароля ----------
# SMTP почтового ящика сайта. 465 — smtps://, 587 — smtp:// (STARTTLS). Пароль — «пароль приложения» из настроек почты.
# Пусто — письма не уходят, а печатаются в лог сервера (docker compose logs app), подтверждение почты не требуется.
SMTP_URL=smtps://hello@igrodrom.ru:пароль-приложения@smtp.yandex.ru:465
MAIL_FROM=Игродром <hello@igrodrom.ru>
# Адрес сайта для ссылок в письмах. По умолчанию https://DOMAIN.
SITE_URL=

# ---------- Сведения о сайте: страницы «Контакты», «Правила», «Конфиденциальность» ----------
# Без них рекламные сети отклоняют заявки.
SITE_EMAIL=hello@igrodrom.ru
SITE_TELEGRAM=igrodrom
SITE_OWNER=Иванов Иван Иванович, самозанятый, ИНН 000000000000
# Номер счётчика Яндекс Метрики (только цифры). Пусто — без счётчика.
METRIKA_ID=

# ---------- Реклама ----------
# Сеть для полноэкранной рекламы и рекламы за награду: none | test | yandex | vk | google
#   none — рекламы нет (полноэкранная не показывается, награда выдаётся сразу)
#   test — тестовая реклама: проверить, как всё работает, до одобрения сети
ADS_PROVIDER=none
# Сеть для баннера под игрой (по умолчанию та же): none | test | yandex | vk | google
ADS_BANNER=
# Полноэкранная — не чаще раза в N секунд и не в первые N секунд игры.
ADS_FULLSCREEN_INTERVAL=60
ADS_FIRST_DELAY=30

# Рекламная сеть Яндекса (partner.yandex.ru): ID блоков вида R-A-1234567-1.
ADS_YANDEX_FULLSCREEN_DESKTOP=
ADS_YANDEX_FULLSCREEN_TOUCH=
ADS_YANDEX_REWARDED_DESKTOP=
ADS_YANDEX_REWARDED_TOUCH=
ADS_YANDEX_BANNER=

# VK Реклама (ads.vk.com/partner): баннер, data-ad-client и data-ad-slot из кода блока.
ADS_VK_BANNER_CLIENT=
ADS_VK_BANNER_SLOT=

# Google H5 Games Ads: ca-pub-… и слот баннера. ADS_GOOGLE_TEST=1 — тестовые объявления.
ADS_GOOGLE_CLIENT=
ADS_GOOGLE_BANNER_SLOT=
ADS_GOOGLE_TEST=

# Строки ads.txt, которые даст сеть; переносы — \n. Или положите файл ads.txt в том данных (/data/ads.txt).
ADS_TXT=
