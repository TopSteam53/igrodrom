{$DOMAIN} {
	encode zstd gzip
	# Архив игры до 100 МБ плюс запас на заголовки.
	request_body {
		max_size 101MB
	}
	reverse_proxy app:3000
}

# www и старые адреса сайта (REDIRECT_FROM в .env, через пробел) ведут на основной домен.
www.{$DOMAIN} {$REDIRECT_FROM} {
	redir https://{$DOMAIN}{uri} permanent
}
