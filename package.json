{
  "name": "igrodrom",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Площадка HTML5-игр: аккаунты авторов, загрузка ZIP/HTML, модерация, статистика",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "build:catalog": "node scripts/build-catalog.js",
    "build:sdk": "node scripts/build-sdk.js",
    "build": "npm run build:sdk && npm run build:catalog"
  }
}
